# =============================================================================
# Variables de entorno — copia este archivo a `.env.local` y complétalo.
# NUNCA subas `.env.local` al repositorio. Ninguna variable de aquí usa el
# prefijo NEXT_PUBLIC_: todo vive solo en el servidor.
# =============================================================================

# --- Supabase (obligatorias) -------------------------------------------------
# Project Settings → API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Project Settings → API → clave secreta / service_role. SOLO servidor.
# Da acceso total a la base de datos: no la compartas ni la pegues en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administración (obligatoria) --------------------------------------------
# Secreto largo que forma tu enlace privado de administración:
#   https://TU-DOMINIO/admin/acceso/<ADMIN_ACCESS_TOKEN>
# Mínimo 32 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarlo invalida el enlace anterior y cierra las sesiones abiertas.
ADMIN_ACCESS_TOKEN=

# --- Confirmaciones por WhatsApp (obligatoria para mostrar el botón) ---------
# Número que recibe las confirmaciones: código de país + número, solo dígitos.
# Ejemplo Colombia: 573001234567
WHATSAPP_NUMBER=

# --- Opcionales ---------------------------------------------------------------
# URL pública del sitio, sin barra final. Se usa para la vista previa
# (Open Graph) y para construir los enlaces de invitación en el panel admin.
# En local puede omitirse.
SITE_URL=http://localhost:3000
